{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noEmit": true
	},
	"include": [
		"workflows",
		"app",
		"durable-objects",
		".space/**/*",
		".cloudflare/types",
		"cloudflare.config.ts"
	]
}
