{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@space/*": [
				".space/*"
			],
			"@app/*": [
				"app/*"
			],
			"@modules/*": [
				"modules/*"
			],
			"@utils/*": [
				"utils/*"
			],
			"@lib/*": [
				"lib/*"
			]
		}
	},
	"include": [
		"workflows",
		"app",
		"durable-objects",
		".space/**/*",
		".cloudflare/types",
		"cloudflare.config.ts"
	]
}
