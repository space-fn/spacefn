{
	"name": "@spacefn/asteroids",
	"version": "0.1.2",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./hono": {
			"import": "./dist/hono.js",
			"types": "./dist/hono.d.ts"
		},
		"./vite": {
			"import": "./dist/vite.js",
			"types": "./dist/vite.d.ts"
		}
	},
	"scripts": {
		"build": "tsup && node scripts/build-publish-json.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@spacefn/css": "workspace:*",
		"@spacefn/datastar": "workspace:*",
		"@spacefn/db": "workspace:*",
		"@spacefn/html": "workspace:*",
		"@spacefn/vite-plugin": "workspace:*",
		"@types/node": "^22.0.0",
		"hono": "^4.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.5.0",
		"vitest": "^3.0.0"
	},
	"peerDependencies": {
		"hono": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"hono": {
			"optional": true
		}
	}
}
