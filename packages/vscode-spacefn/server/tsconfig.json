{
	"compilerOptions": {
		"module": "preserve",
		"target": "ES2022",
		"lib": ["ES2022"],
		"sourceMap": true,
		"rootDir": "src",
		"outDir": "../server-out",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"moduleResolution": "bundler",
		"noEmit": true
	},
	"include": ["src"]
}
