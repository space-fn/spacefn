{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2022",
		"lib": ["ES2022"],
		"sourceMap": true,
		"rootDir": "src",
		"outDir": "out",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"typeRoots": ["../../node_modules/@types", "./node_modules/@types"]
	},
	"exclude": ["node_modules", ".vscode-test", "server", "vite.config.ts"]
}
