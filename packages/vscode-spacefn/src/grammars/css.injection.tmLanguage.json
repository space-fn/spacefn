{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"scopeName": "source.css.spacefn.injection",
	"injectionSelector": "L:source.js -comment, L:source.ts -comment, L:source.jsx -comment, L:source.tsx -comment",
	"patterns": [{ "include": "#css-template" }],
	"repository": {
		"css-template": {
			"name": "meta.embedded.block.css.spacefn",
			"contentName": "source.css",
			"begin": "\\b(css)(`)",
			"end": "(`)",
			"beginCaptures": {
				"1": { "name": "entity.name.function.tagged-template.js" },
				"2": { "name": "punctuation.definition.string.template.begin.js" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.string.template.end.js" }
			},
			"patterns": [
				{
					"begin": "(\\$\\{)",
					"end": "(\\})",
					"beginCaptures": { "1": { "name": "punctuation.section.embedded.begin.js" } },
					"endCaptures": { "1": { "name": "punctuation.section.embedded.end.js" } },
					"patterns": [{ "include": "source.ts" }]
				},
				{ "include": "source.css" }
			]
		}
	}
}
