{
	"name": "vscode-spacefn",
	"displayName": "spacefn",
	"version": "0.2.0",
	"description": "spacefn support for VS Code: HTML injection for html tagged templates (Datastar) + SQL diagnostics for db queries.",
	"categories": [
		"Programming Languages"
	],
	"publisher": "wai-lin",
	"main": "./out/extension.js",
	"scripts": {
		"compile": "tsc -p . && npm run bundle",
		"package": "vsce package",
		"bundle": "esbuild server/src/server.ts --bundle --platform=node --outfile=server-out/server.js --external:vscode --external:vscode-languageserver --external:vscode-languageserver-textdocument --external:vscode-html-languageservice"
	},
	"dependencies": {
		"vscode-html-languageservice": "^5.6.2",
		"vscode-languageclient": "^9.0.1",
		"vscode-languageserver": "^9.0.1",
		"vscode-languageserver-textdocument": "^1.0.12"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/vscode": "^1.63.0",
		"esbuild": "^0.24.0",
		"node-sql-parser": "^5.3.0",
		"spacefn": "workspace:*",
		"typescript": "^7.0.2",
		"vsce": "^2.15.0"
	},
	"contributes": {
		"grammars": [
			{
				"injectTo": [
					"source.js",
					"source.ts"
				],
				"scopeName": "source.datastar.spacefn.injection",
				"path": "./src/grammars/javascript.injection.tmLanguage.json"
			},
			{
				"injectTo": [
					"source.js",
					"source.ts"
				],
				"scopeName": "source.sql.spacefn.injection",
				"path": "./src/grammars/sql.injection.tmLanguage.json"
			}
		]
	},
	"activationEvents": [
		"onLanguage:javascript",
		"onLanguage:sql",
		"onLanguage:typescript",
		"workspaceContains:app/db"
	],
	"engines": {
		"vscode": "^1.63.0"
	}
}
