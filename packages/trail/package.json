{
	"name": "@spacefn/trail",
	"version": "0.1.0",
	"description": "Sentry-like tracing and telemetry for SpaceFn apps",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./hono": {
			"import": "./dist/hono.js",
			"types": "./dist/hono.d.ts"
		},
		"./kysely": {
			"import": "./dist/kysely.js",
			"types": "./dist/kysely.d.ts"
		},
		"./client": {
			"import": "./dist/client.js",
			"types": "./dist/client.d.ts"
		}
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"hono": "^4.0.0",
		"kysely": "^0.28.0",
		"kysely-d1": "^0.4.0",
		"kysely-libsql": "^0.7.1",
		"miniflare": "3.20250718.3",
		"tsup": "^8.0.0",
		"typescript": "^5.5.0",
		"vitest": "^3.0.0"
	},
	"peerDependencies": {
		"hono": ">=4.0.0",
		"kysely": ">=0.27.0"
	},
	"peerDependenciesMeta": {
		"hono": {
			"optional": true
		},
		"kysely": {
			"optional": true
		}
	}
}
