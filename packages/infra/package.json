{
	"name": "@spacefn/infra",
	"version": "0.11.0-alpha.0",
	"description": "Infrastructure, local dev and deploy for spacefn apps (via Alchemy)",
	"license": "Apache-2.0",
	"author": "wai-lin",
	"bin": {
		"space": "./src/cli.ts"
	},
	"files": [
		"dist",
		"docker"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./vite": "./src/vite.ts",
		"./cloudflare": "./src/cloudflare.ts",
		"./docker": "./src/docker.ts"
	},
	"publishConfig": {
		"bin": {
			"space": "./dist/cli.mjs"
		},
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"import": "./dist/index.mjs"
			},
			"./vite": {
				"types": "./dist/vite.d.mts",
				"import": "./dist/vite.mjs"
			},
			"./cloudflare": {
				"types": "./dist/cloudflare.d.mts",
				"import": "./dist/cloudflare.mjs"
			},
			"./docker": {
				"types": "./dist/docker.d.mts",
				"import": "./dist/docker.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@libsql/client": "catalog:",
		"alchemy": "catalog:"
	},
	"devDependencies": {
		"@alchemy.run/cloudflare": "catalog:",
		"@alchemy.run/docker": "catalog:",
		"@effect/vitest": "catalog:",
		"@spacefn/bun": "workspace:*",
		"@types/node": "^26.6.6",
		"effect": "catalog:",
		"spacefn": "workspace:*",
		"tsdown": "catalog:",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@alchemy.run/cloudflare": "2.0.0-beta.87",
		"@alchemy.run/docker": "2.0.0-beta.87",
		"effect": "^4.1.4",
		"spacefn": "workspace:^",
		"vite": "^8.3.8"
	},
	"peerDependenciesMeta": {
		"@alchemy.run/cloudflare": {
			"optional": true
		},
		"@alchemy.run/docker": {
			"optional": true
		}
	}
}
