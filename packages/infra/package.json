{
	"name": "@spacefn/infra",
	"version": "0.11.0-alpha.0",
	"description": "Infrastructure, local dev and deploy for spacefn apps (via Alchemy)",
	"license": "Apache-2.0",
	"author": "wai-lin",
	"bin": {
		"space": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./vite": "./src/vite.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"import": "./dist/index.mjs"
			},
			"./vite": {
				"types": "./dist/vite.d.mts",
				"import": "./dist/vite.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@alchemy.run/cloudflare": "catalog:",
		"@alchemy.run/docker": "catalog:",
		"@effect/platform-node": "catalog:",
		"@libsql/client": "catalog:",
		"alchemy": "catalog:"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@spacefn/bun": "workspace:*",
		"@spacefn/cloudflare": "workspace:*",
		"@types/node": "^26.6.6",
		"effect": "catalog:",
		"spacefn": "workspace:*",
		"tsdown": "catalog:",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.1.4",
		"spacefn": "workspace:^",
		"vite": "^8.3.8"
	}
}
