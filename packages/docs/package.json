{
	"name": "@spacefn/docs",
	"version": "0.11.0-alpha.0",
	"description": "spacefn's docs and the reader `space docs` serves them with",
	"keywords": [
		"docs",
		"spacefn"
	],
	"homepage": "https://github.com/space-fn/spacefn#readme",
	"license": "Apache-2.0",
	"author": "wai-lin",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/space-fn/spacefn.git",
		"directory": "packages/docs"
	},
	"files": [
		"dist",
		"assets",
		"content"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"import": "./dist/index.mjs",
				"default": "./dist/index.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@shikijs/transformers": "^4.6.0",
		"launch-editor": "^2.14.2",
		"marked": "^18.2.1",
		"shiki": "^4.6.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsdown": "catalog:",
		"typescript": "^7.0.2",
		"vitest": "catalog:"
	}
}
