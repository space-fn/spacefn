{
  "name": "@spacefn/cli",
  "version": "0.1.1",
  "description": "Unified CLI for SpaceFn projects — dev, build, fmt, lint, and script runner",
  "type": "module",
  "bin": {
    "space": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "biome.json"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "cli-table3": "^0.6.5",
    "consola": "^3.4.2",
    "citty": "^0.2.2",
    "execa": "^10.0.1",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.0.0",
    "@spacefn/db": ">=0.3.0",
    "vite": ">=5.0.0",
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@spacefn/db": { "optional": true },
    "vitest": { "optional": true }
  }
}
