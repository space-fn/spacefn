{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"paths": {
			"@space/*": ["../../.space/*"],
			"@app/*": ["../*"],
			"@modules/*": ["../../modules/*"],
			"@utils/*": ["../../utils/*"],
			"@lib/*": ["../../lib/*"]
		}
	},
	"include": ["."]
}
