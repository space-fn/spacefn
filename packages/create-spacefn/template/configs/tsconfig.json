{
	"extends": "../.space/tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["../app", "../lib", "../modules", "../utils", "../configs", "../.space"],
	"exclude": ["../.space/dist", "../.space/.alchemy"]
}
