{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "#space/*": ["./.space/*"],
      "#db/*": ["./src/db/*"],
      "#*": ["./*"]
    }
  },
  "include": ["src", "configs", "scripts"]
}
