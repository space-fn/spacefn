{
	"name": "@spacefn/sql",
	"version": "0.11.0-alpha.0",
	"description": "SQL parsing, splitting and type inference for spacefn (no runtime dependencies)",
	"license": "Apache-2.0",
	"author": "wai-lin",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./node": {
			"types": "./dist/node/index.d.mts",
			"import": "./dist/node/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsdown": "catalog:",
		"typescript": "^7.0.2",
		"vitest": "catalog:"
	}
}
