{
	"name": "spacefn",
	"version": "0.11.0-alpha.0",
	"description": "Folder-convention framework on Effect, portable across Cloudflare and Bun, with its CLI and deploys",
	"keywords": [
		"bun",
		"cloudflare-workers",
		"datastar",
		"effect",
		"framework",
		"sqlite"
	],
	"homepage": "https://github.com/space-fn/spacefn#readme",
	"license": "Apache-2.0",
	"author": "wai-lin",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/space-fn/spacefn.git",
		"directory": "packages/spacefn"
	},
	"bin": {
		"space": "./src/infra/cli.ts"
	},
	"files": [
		"dist",
		"docker"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./config": "./src/space-config.ts",
		"./testing": "./src/testing.ts",
		"./codegen": "./src/codegen/index.ts",
		"./runtime": "./src/runtime.ts",
		"./sql": "./src/sql/index.ts",
		"./sql/node": "./src/sql/node/index.ts",
		"./cloudflare": "./src/cloudflare/index.ts",
		"./bun": "./src/bun/index.ts",
		"./vite": "./src/infra/vite.ts",
		"./infra": "./src/infra/index.ts",
		"./infra/cloudflare": "./src/infra/cloudflare.ts",
		"./infra/docker": "./src/infra/docker.ts"
	},
	"publishConfig": {
		"bin": {
			"space": "./dist/infra/cli.mjs"
		},
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"import": "./dist/index.mjs"
			},
			"./config": {
				"types": "./dist/space-config.d.mts",
				"import": "./dist/space-config.mjs"
			},
			"./testing": {
				"types": "./dist/testing.d.mts",
				"import": "./dist/testing.mjs"
			},
			"./codegen": {
				"types": "./dist/codegen/index.d.mts",
				"import": "./dist/codegen/index.mjs"
			},
			"./runtime": {
				"types": "./dist/runtime.d.mts",
				"import": "./dist/runtime.mjs"
			},
			"./sql": {
				"types": "./dist/sql/index.d.mts",
				"import": "./dist/sql/index.mjs"
			},
			"./sql/node": {
				"types": "./dist/sql/node/index.d.mts",
				"import": "./dist/sql/node/index.mjs"
			},
			"./cloudflare": {
				"types": "./dist/cloudflare/index.d.mts",
				"import": "./dist/cloudflare/index.mjs"
			},
			"./bun": {
				"types": "./dist/bun/index.d.mts",
				"import": "./dist/bun/index.mjs"
			},
			"./vite": {
				"types": "./dist/vite.d.mts",
				"import": "./dist/vite.mjs"
			},
			"./infra": {
				"types": "./dist/infra/index.d.mts",
				"import": "./dist/infra/index.mjs"
			},
			"./infra/cloudflare": {
				"types": "./dist/infra/cloudflare.d.mts",
				"import": "./dist/infra/cloudflare.mjs"
			},
			"./infra/docker": {
				"types": "./dist/infra/docker.d.mts",
				"import": "./dist/infra/docker.mjs"
			}
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsdown",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cloudflare.json && tsc --noEmit -p tsconfig.bun.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@effect/platform-node": "^4.1.4",
		"@effect/sql-d1": "^4.1.4",
		"@effect/sql-libsql": "^4.1.4",
		"@effect/sql-sqlite-do": "^4.1.4",
		"@effect/sql-sqlite-node": "^4.1.4",
		"@libsql/client": "^0.18.0",
		"alchemy": "catalog:"
	},
	"devDependencies": {
		"@alchemy.run/cloudflare": "catalog:",
		"@alchemy.run/docker": "catalog:",
		"@cloudflare/workers-types": "^5.20261030.1",
		"@effect/vitest": "catalog:",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"effect": "catalog:",
		"esbuild": "catalog:",
		"miniflare": "catalog:",
		"spacefn-docs": "workspace:*",
		"tsdown": "catalog:",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@alchemy.run/cloudflare": "2.0.0-beta.87",
		"@alchemy.run/docker": "2.0.0-beta.87",
		"effect": "^4.1.4",
		"vite": "^8.3.8"
	},
	"peerDependenciesMeta": {
		"@alchemy.run/cloudflare": {
			"optional": true
		},
		"@alchemy.run/docker": {
			"optional": true
		}
	}
}
