{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": [],
		"jsx": "react-jsx"
	},
	"include": ["../app", "../lib", "../modules", "../configs"]
}
