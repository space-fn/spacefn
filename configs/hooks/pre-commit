#!/bin/sh
# Formats and lint-fixes the staged files, then stages the fixes.
# Calls the root scripts so the -c and ignore flags live only in package.json:
# oxlint/oxfmt resolve config ignorePatterns from configs/, so they can't ignore repo paths.
set -e

files=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')
[ -z "$files" ] && exit 0

echo "$files" | tr '\n' '\0' | xargs -0 pnpm --silent fmt --no-error-on-unmatched-pattern
echo "$files" | grep -E '\.(c|m)?[jt]sx?$' | tr '\n' '\0' | xargs -0 -r pnpm --silent lint --fix
echo "$files" | tr '\n' '\0' | xargs -0 git add --
