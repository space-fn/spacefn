{
	"name": "space-root",
	"private": true,
	"description": "",
	"keywords": [],
	"license": "Apache-2.0",
	"author": "wai-lin",
	"type": "module",
	"scripts": {
		"check": "pnpm fmt --check && pnpm lint && pnpm typecheck",
		"fmt": "oxfmt -c configs/oxfmt.json '!legacy/**'",
		"lint": "oxlint -c configs/oxlint.json --ignore-pattern 'legacy/**' --ignore-pattern 'packages/create-spacefn/template/**'",
		"prepare": "git config core.hooksPath configs/hooks",
		"publish": "./scripts/publish.sh",
		"publish:vscode": "./scripts/publish-vscode.sh",
		"typecheck": "pnpm -r --filter './packages/*' typecheck",
		"test": "pnpm -r --filter './packages/*' test",
		"examples": "node scripts/examples.ts && pnpm install",
		"pack:check": "node scripts/pack-check.ts"
	},
	"devDependencies": {
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007"
	},
	"packageManager": "pnpm@12.15.0"
}
